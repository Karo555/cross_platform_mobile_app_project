rules_version = '2';

// Starting point from #4: every read and write is rejected.
// The real rules (unauthenticated access, the role matrix, validation)
// are added in #12, #17 and #18, each with tests in #20.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
