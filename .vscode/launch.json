{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "iOS simulator (local emulators)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define=EMULATOR_HOST=localhost"]
    },
    {
      "name": "Android emulator (local emulators)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define=EMULATOR_HOST=10.0.2.2"]
    },
    {
      "name": "Chrome (local emulators)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": ["--dart-define=EMULATOR_HOST=localhost"]
    },
    {
      "name": "Real Firebase project",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define=USE_EMULATOR=false"]
    }
  ]
}
