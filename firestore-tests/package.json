{
  "name": "firestore-tests",
  "description": "Security-rules tests for firestore.rules, run against the Firestore emulator.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-rules-test \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0"
  }
}
